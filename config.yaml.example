company:
  name: "Muster GmbH"            # the work log's head, unless there is a logo

staff:                           # who works with the tool
  names: ["Max Mustermann"]
  current: Max Mustermann        # the Lieferant on the travel expenses, whose Harvest hours count

mail:
  smtpHost: "smtp.example.com"
  smtpPort: 587
  imapHost: "imap.example.com"
  imapPort: 993
  username: "user@example.com"
  password: "your-password"
  from: "user@example.com"       # optional, falls back to username
  to: "recipient@example.com"
  cc: "autobox@sevdesk.email"    # optional


travel-expense:
  christmasWeekOff: true         # optional, default: true (exclude Dec 24, 27-31)
  clients:
    - id: "1"
      name: Acme GmbH
      from: "Stuttgart, Heimatbüro"
      to: "München, Acme GmbH"
      reason: Projektarbeit
      distance: 42               # one-way distance in km
      province: BW               # German state abbreviation for holiday calendar

anthropic-invoice:
  filter:
    count: 50                    # how many recent emails to scan, in each folder
    from: "mail.anthropic.com"
    subject: "Your receipt from Anthropic"
    folders: [INBOX, Rechnungen] # the inbox first

apple-invoice:
  filter:
    count: 50                    # how many recent emails to scan, in each folder
    from: "apple.com"
    subject: "Deine Rechnung von Apple"
    folders: [INBOX, Rechnungen] # the inbox first

vodafone-invoice:
  username: "your-vodafone-email@example.com"
  password: "your-vodafone-password"
  fallbackToLastMonth: true      # optional, default: true (send last month's invoice if current not yet available)

harvest-invoice:
  skipExisting: true               # optional, default: true (skip if sevDesk already has invoice for same period)
  harvest:
    token: "123456.pt.your-personal-access-token"   # id.getharvest.com/developers
    client: "Acme GmbH"                  # optional: the client in Harvest, default sevdesk.clientName
  sevdesk:
    username: "sevdesk-login@example.com"
    password: "your-sevdesk-password"
    clientName: "Acme GmbH"              # the client in sevDesk
    productName: "Acme Produkt"          # search term typed into product field
    productNum: "0102"                   # article number to select from dropdown
    referenceNum: "REF-123"              # Kundenreferenz für E-Rechnung
